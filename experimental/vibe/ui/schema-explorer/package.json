{
  "name": "@quent-experimental/schema-explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --workspace ./src --tsconfig ../tsconfig.json --config ../vite.config.ts && tsc --noEmit",
    "lint": "eslint --config ../../../../ui/eslint.config.js --rule \"prettier/prettier: off\" \"src/**/*.ts\" vite.config.ts",
    "wasm:build": "rustup run 1.97.0 cargo build --manifest-path ../../../../Cargo.toml -p quent-yaml --features wasm --target wasm32-unknown-unknown --release && wasm-bindgen ../../../../target/wasm32-unknown-unknown/release/quent_yaml.wasm --target web --out-dir wasm --out-name quent_yaml",
    "wasm:test": "node scripts/verify-yaml-wasm.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@quent/schema-viewer": "workspace:*",
    "codemirror": "^6.0.2",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.4",
    "eslint": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "8.1.5"
  }
}
